{
  "name": "obsidian-lexis",
  "version": "1.17.24",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:pdf-layout": "node tests/pdf-layout.browser.mjs",
    "test:browser-shadow": "node tests/browser-shadow.browser.mjs",
    "test:browser-math": "node tests/browser-math.browser.mjs",
    "test:browser-math-layout": "node tests/browser-math-layout.browser.mjs",
    "test:browser-pill-position": "node tests/browser-pill-position.browser.mjs",
    "test:popover-editor": "node tests/popover-editor.browser.mjs",
    "test:epub": "node tests/epub-selection.browser.mjs",
    "test:settings-layout": "node tests/settings-layout.browser.mjs",
    "test:curve": "node tests/curve-view.browser.mjs",
    "test:alias-options": "node tests/alias-options.browser.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:marginnote": "tsc -p pkg/marginnote-extension/tsconfig.json",
    "build:marginnote": "npm run typecheck:marginnote && node pkg/marginnote-extension/build.mjs",
    "lint": "eslint .",
    "build": "tsc --noEmit && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6"
  }
}
